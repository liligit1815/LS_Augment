  test("window-only native proof succeeds without an editor and never coerces to commit authority",()->{Fixture f=new Fixture();f.install();f.user.mCurEditorInfo.inputType=0;f.user.mCurInputConnection=null;f.user.mCurRemoteAccessibilityInputConnection=null;Bundle b=ls.augment.com.QueryBoundary.window(f.wm);check(b.getInt("schema")==2&&b.getInt("a11y_window")==71&&!b.containsKey("input_type")&&!b.containsKey("connection_generation")&&!b.toString().contains("secret"),"window-only proof fabricated editor or leaked body");check(!ls.augment.com.QueryBoundary.coerces(b),"window-only proof coerced to editor authority");f.deny();});
  test("window-only and later full proof share the exact native window generation",()->{Fixture f=new Fixture();f.install();Bundle a=ls.augment.com.QueryBoundary.window(f.wm),b=f.query();check(a.getString("window_generation").equals(b.getString("window_generation")),"same native window generation drifted");});
  for(String cause:new String[]{"caller","root_pid","deadline","task","window_token","focus","package","uid","user","display","own_content","a11y_token","a11y_user"})test("window-only preserves native guard "+cause,()->{Fixture f=new Fixture();f.install();switch(cause){case "caller":Binder.uid=10055;break;case "root_pid":Binder.pid=999;android.os.Process.uids.put(999,0);break;case "deadline":SystemClock.time=6000;break;case "task":f.window.task.mTaskId=99;break;case "window_token":f.wm.mWindowMap.clear();break;case "focus":f.wm.mRoot.display.mCurrentFocus=null;break;case "package":f.window.mActivityRecord.packageName="other";break;case "uid":f.window.mOwnerUid=10102;break;case "user":f.wm.mCurrentUserId=1;break;case "display":f.wm.mRoot.display.mDisplay.unique="reused";break;case "own_content":f.dms().info.flags=0;break;case "a11y_token":f.am.mA11yWindowManager.token=new Token();break;case "a11y_user":f.am.mCurrentUserId=1;break;}try{ls.augment.com.QueryBoundary.window(f.wm);throw new AssertionError("window-only native guard bypassed");}catch(IllegalStateException expected){checks++;}check(f.wm.nativeCalls==0,"window-only request reached AIDL");});
  for(int phase:new int[]{1,2})test("window-only focus race in a11y phase "+phase,()->{Fixture f=new Fixture();f.install();int[] n={0};f.am.mA11yWindowManager.onFind=()->{if(++n[0]==phase)f.wm.mRoot.display.mCurrentFocus=new WindowState();};try{ls.augment.com.QueryBoundary.window(f.wm);throw new AssertionError("window-only phase race authorized");}catch(IllegalStateException expected){checks++;}});
  test("window-only synchronous flags keep bounded auth/framing and original behavior",()->{for(int flags:new int[]{0,2,16,18})for(int mode=0;mode<4;mode++){Fixture f=new Fixture();f.install();NativeBinderWire.remote=false;Parcel d=stageEditorPacket(f),out=Parcel.obtain();d.values.set(1,2);if(mode==1)Binder.uid=10055;if(mode==2)d.forcedSize=4097;if(mode==3)d.writeInt(9);f.wm.transact(0x00D04E01,d,out,flags);out.readException();check(out.readInt()==(mode==1||mode==2?1:2),"window-only refusal framing changed");out.readString();check(out.readInt()==(mode==0?1:0)&&f.wm.nativeCalls==0,"window-only flags bypassed framing/auth");}for(int flags:new int[]{1,3,4,17,19,20}){Fixture f=new Fixture();f.install();NativeBinderWire.remote=false;Parcel d=stageEditorPacket(f),out=Parcel.obtain();d.values.set(1,2);int before=d.dataAvail();check(f.wm.transact(0x00D04E01,d,out,flags)&&out.dataAvail()==0&&d.dataAvail()==before&&f.wm.nativeCalls==0,"window-only oneway decoded");}});
  test("window-only codec rejects editor schema nonce stale sample and extra reply",()->{for(int mode=0;mode<4;mode++){final int which=mode;IBinder fake=new IBinder(){public boolean isBinderAlive(){return true;}public boolean transact(int code,Parcel request,Parcel reply,int flags){request.enforceInterface("ls.augment.com.atomic_editor_evidence.v1");request.readInt();String nonce=request.readString();reply.writeNoException();reply.writeInt(which==0?1:2);reply.writeString(which==1?"forged":nonce);reply.writeInt(1);reply.writeInt(71);reply.writeString("1".repeat(32));reply.writeLong(which==2?2000:1000);if(which==3)reply.writeInt(99);return true;}};try{ls.augment.com.QueryBoundary.window(fake);throw new AssertionError("forged window-only reply accepted");}catch(IllegalStateException expected){checks++;}}});
