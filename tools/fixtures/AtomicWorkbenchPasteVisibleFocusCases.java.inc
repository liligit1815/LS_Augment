  test("native ignored commit stays unverified and does not retry",()->{F f=new F();f.ignore=true;var result=f.run();check(!result.verified&&result.dispatched&&f.commits==1&&f.body.equals("")&&result.focusRestored,"ignored commit reported success or retried");f.close();});
  test("window bundle preserves exact typed metadata and rejects foreign request",()->{F f=new F();var p=f.windowProof();check(p.matches(f.r,1000)&&!p.matches(request(),1000),"window proof borrowed another request");Bundle b=p.toBundle();b.getBundle("request").putLong("task",42);check(!AtomicWorkbenchEditorEvidence.WindowEvidence.fromBundle(b).matches(f.r,1000),"wrong typed request matched window proof");b=p.toBundle();b.putString("text","forbidden");try{AtomicWorkbenchEditorEvidence.WindowEvidence.fromBundle(b);throw new AssertionError("extra proof field accepted");}catch(IllegalArgumentException expected){checks++;}f.close();});
