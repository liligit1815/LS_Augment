  for(String mode:new String[]{"host_failure","return_failure","window_changed","newer_input","expired"})test("window refresh keeps cleanup and guard "+mode,()->{F f=new F();f.partial();check(focus(f),"focus setup failed");f.staleWindowBinding=true;switch(mode){case "host_failure":f.refreshFail=true;break;case "return_failure":f.returnFail=true;break;case "window_changed":f.windowGeneration="3".repeat(32);break;case "newer_input":f.windowQueryHook=()->f.revision++;break;case "expired":f.windowQueryHook=()->SystemClock.time=6000;break;}check(!f.host.prepare(f.r.metadata()).getBoolean("success")&&f.commits==0,"unsafe window refresh prepared editor");int actions=f.focuses.size();check(actions==(mode.equals("host_failure")?2:mode.equals("return_failure")?3:1),"window refresh ignored native guard");f.refreshFail=f.returnFail=false;f.windowQueryHook=null;f.close();});
  test("native refresh is bounded and cannot convert repeated editor failure to success",()->{F f=new F();f.partial();check(focus(f),"focus setup failed");f.fullMissing=true;check(!f.host.prepare(f.r.metadata()).getBoolean("success")&&f.focuses.equals(List.of(0,-1,0)),"missing full proof refreshed incorrectly");check(!f.host.prepare(f.r.metadata()).getBoolean("success")&&f.focuses.size()==3&&f.commits==0,"repeated prepare repeated focus cycle");f.close();});
  System.out.println("VISIBLE FOCUS RESULT "+cases+" cases; "+checks+" assertions");
