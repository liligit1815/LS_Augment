 static boolean focus(F f)throws Exception{try{return AtomicWorkbenchPasteService.focusFirstVisible(f.r,f.windowProof());}catch(IllegalStateException expired){if("deadline".equals(expired.getMessage()))return false;throw expired;}}
 static void rejectsCapture(F f,String message)throws Exception{try{AtomicWorkbenchPasteService.backend().capture(f.r,f.fullProof());throw new AssertionError(message);}catch(IllegalStateException expected){checks++;}}
 public static void main(String[] args)throws Exception{
  test("first visible editor receives one verified commit and original side focus restores",()->{F f=new F();var result=f.run();check(result.verified&&result.dispatched&&result.focusRestored&&f.body.equals("新")&&f.commits==1,"no-focus full chain not verified once");check(f.first.focusActions==1&&f.second.focusActions==0&&f.second.text.equals("")&&f.focuses.equals(List.of(0,1)),"first editor or focus restore wrong");f.close();});
  test("hidden editor is skipped in native child order",()->{F f=new F();f.first.visible=false;check(focus(f)&&f.first.focusActions==0&&f.second.focusActions==1,"hidden first editor selected");check(f.reads==0&&f.commits==0&&f.first.textReads==0&&f.second.textReads==0,"focus discovery read text");f.close();});
  test("disabled editor is skipped in native child order",()->{F f=new F();f.first.enabled=false;check(focus(f)&&f.first.focusActions==0&&f.second.focusActions==1,"disabled first editor was selected");f.close();});
  test("existing focused editor keeps its caret and receives no focus pulse",()->{F f=new F();f.first.focused=true;f.first.start=f.first.end=0;f.root.focus=f.first;f.method.onStartInput(new EditorInfo(),false);check(!focus(f)&&f.first.focusActions==0,"focused caret was refocused");check(f.run().verified&&f.commits==1,"existing focus path regressed");f.close();});
  for(String mode:new String[]{"window_id","display","background","type","root_package","node_package","node_window","stale","deadline","missing_child","no_editor","budget"})test("focus discovery rejects "+mode,()->{F f=new F();switch(mode){case "window_id":f.window.id=72;break;case "display":f.window.display=89;break;case "background":f.window.focused=false;break;case "type":f.window.type=2;break;case "root_package":f.root.pkg="other";break;case "node_package":f.first.pkg="other";break;case "node_window":f.first.window=72;break;case "stale":f.windowGeneration="invalid";break;case "deadline":SystemClock.time=6000;break;case "missing_child":f.root.children.set(1,null);break;case "no_editor":f.first.editable=f.second.editable=false;break;case "budget":f.root.children.clear();for(int i=0;i<129;i++)f.root.children.add(F.node(false,10+i));break;}check(!focus(f)&&f.first.focusActions==0&&f.second.focusActions==0&&f.commits==0,"unsafe focus discovery proceeded");f.close();});
  for(boolean existing:new boolean[]{false,true})test("password first/current editor never receives focus or content access "+existing,()->{F f=new F();f.first.password=true;if(existing){f.root.focus=f.first;f.first.focused=true;}try{focus(f);throw new AssertionError("password editor focused");}catch(IllegalStateException expected){check(expected.getMessage().equals("password_editor"),"password reason hidden");}check(f.first.focusActions==0&&f.reads==0&&f.commits==0,"password editor accessed");f.close();});
  test("node refresh and a newly focused editable revoke discovery",()->{F f=new F();f.first.onRefresh=()->f.first.pkg="other";check(!focus(f)&&f.first.focusActions==0,"changed node focused");f.close();F g=new F();int[] finds={0};g.root.onFind=()->{if(++finds[0]==2){g.root.focus=g.second;g.second.focused=true;}};check(!focus(g)&&g.first.focusActions==0,"newly focused editor was overridden");g.close();});
  test("native ACTION_FOCUS failure cannot produce editor authority",()->{F f=new F();f.first.actionResult=false;check(!focus(f)&&f.first.focusActions==0&&f.commits==0,"failed native focus accepted");f.close();});
  test("focus callback must start a fresh native editor binding",()->{F f=new F();f.allowBind=false;f.first.onRefresh=()->SystemClock.time+=1001;try{focus(f);throw new AssertionError("unbound focus accepted");}catch(IllegalStateException expected){check(f.commits==0&&f.reads==0,"unbound focus read or committed");}f.close();});
  test("redirected native node never receives capture from an earlier focus receipt",()->{F f=new F();check(focus(f),"focus setup failed");f.first.focused=false;f.second.focused=true;f.root.focus=f.second;rejectsCapture(f,"redirected node authorized capture");f.close();});
  test("interrupt invalidates pending focus receipt",()->{F f=new F();check(focus(f),"focus setup failed");f.service.onInterrupt();f.method.onStartInput(new EditorInfo(),false);rejectsCapture(f,"interrupted focus receipt authorized capture");f.close();});
  test("disconnect and replacement service retain invalid receipt tombstone",()->{F f=new F();check(focus(f),"focus setup failed");f.service.onDestroy();var replacement=new AtomicWorkbenchPasteService();var method=replacement.onCreateInputMethod();replacement.onServiceConnected();method.onStartInput(new EditorInfo(),false);rejectsCapture(f,"reconnected service authorized old focus receipt");replacement.onDestroy();f.close();});
  test("window-only lease stays live for discovery and never validates as editor",()->{F f=new F();Bundle p=f.partial();check(f.host.awaitingVisibleFocus(f.r.metadata())&&f.host.maintain().getString("reason").equals("window_prepared")&&f.focuses.equals(List.of(0)),"maintenance retired active discovery");check(!f.host.validate(f.r.metadata(),p.getBundle("window_evidence")).getBoolean("success")&&f.commits==0,"window-only proof validated editing");check(focus(f)&&f.host.prepare(f.r.metadata()).getBoolean("success")&&f.focuses.size()==1,"second prepare focused twice");f.close();});
  for(String mode:new String[]{"window_generation","a11y_window","target","newer_input","session","deadline","editor_missing"})test("second stage preserves guard "+mode,()->{F f=new F();f.partial();check(focus(f),"focus setup failed");switch(mode){case "window_generation":f.fullGeneration="3".repeat(32);break;case "a11y_window":f.fullA11y=72;break;case "target":f.states.get(0).putInt("task_id",99);break;case "newer_input":f.revision++;break;case "session":f.session=false;break;case "deadline":SystemClock.time=6000;break;case "editor_missing":f.fullMissing=true;break;}Bundle b=f.host.prepare(f.r.metadata());check(!b.getBoolean("success")&&f.commits==0,"different native window completed discovery");check(f.focuses.size()==(mode.equals("editor_missing")?3:1),"rejected second stage pulsed focus");f.close();});
