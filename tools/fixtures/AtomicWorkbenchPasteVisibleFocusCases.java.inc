public final class TestVisibleFocus {
 static int cases,checks,sequence;static void check(boolean v,String why){checks++;if(!v)throw new AssertionError(why);}interface Case{void run()throws Exception;}static void test(String n,Case c)throws Exception{SystemClock.time=1000;c.run();cases++;System.out.println("PASS visible focus: "+n);}
 static AtomicWorkbenchPasteRequest request(){return new AtomicWorkbenchPasteRequest(String.format("%032x",++sequence),7,2,4,0,88,"DuoAtomic-10055-w0-12345678-1234-1234-1234-123456789abc","virtual:root,88",0,10055,10101,42,"example.editor","source1",3,"新",1000,6000);}
 static Bundle state(int id){Bundle b=new Bundle();b.putBoolean("success",true);b.putString("state","active");b.putBoolean("recovery_pending",false);b.putBoolean("native_home",false);b.putBoolean("home_only",false);b.putInt("window_id",id);b.putInt("display_id",88+id);b.putString("display_name","DuoAtomic-10055-w"+id+"-12345678-1234-1234-1234-123456789abc");b.putString("display_unique_id","virtual:root,"+(88+id));b.putInt("user_id",0);b.putInt("target_uid",10101+id);b.putInt("task_id",42+id);b.putString("package",id==0?"example.editor":"other.editor");return b;}
 static final class F implements AtomicWorkbenchPasteHost.Workspace,AtomicWorkbenchPasteCoordinator.Host {
  final AtomicWorkbenchPasteRequest r=request();final AtomicWorkbenchPasteService service=new AtomicWorkbenchPasteService();InputMethod method;
  final AccessibilityWindowInfo window=new AccessibilityWindowInfo();final AccessibilityNodeInfo root=node(false,1),first=node(true,2),second=node(true,3);
  final AtomicWorkbenchPasteHost host=new AtomicWorkbenchPasteHost(10055,0,7,2,SystemClock::elapsedRealtime,this);
  final Map<Integer,Bundle> states=new HashMap<>();final List<Integer> focuses=new ArrayList<>();int active=1,queries,windowQueries,commits,reads;long revision=10;boolean session=true,windowMissing,fullMissing,ignore,allowBind=true,staleWindowBinding,refreshFail,returnFail;Runnable windowQueryHook;String body="",windowGeneration="1".repeat(32),fullGeneration="1".repeat(32);int fullA11y=71;Runnable queryHook;
  F(){states.put(0,state(0));states.put(1,state(1));root.children.add(first);root.children.add(second);window.root=root;AccessibilityService.windows.clear();AccessibilityService.windows.put(88,new ArrayList<>(List.of(window)));InputMethod.connection=new InputMethod.AccessibilityInputConnection(){public SurroundingText getSurroundingText(int before,int after,int flags){reads++;return new SurroundingText(body,first.start,first.end,0);}public void commitText(CharSequence value,int cursor,Object attr){commits++;if(!ignore){body=value.toString();first.text=body;first.start=first.end=body.length();}}};method=service.onCreateInputMethod();service.onServiceConnected();first.onFocus=()->{root.focus=first;if(allowBind)method.onStartInput(new EditorInfo(),false);};second.onFocus=()->{root.focus=second;if(allowBind)method.onStartInput(new EditorInfo(),false);};}
  static AccessibilityNodeInfo node(boolean editable,int id){var n=new AccessibilityNodeInfo();n.editable=editable;n.focused=false;n.identity=id;n.start=n.end=0;n.text="";return n;}
  AtomicWorkbenchEditorEvidence.WindowEvidence windowProof(){return new AtomicWorkbenchEditorEvidence.WindowEvidence(r,71,windowGeneration,SystemClock.time);}
  AtomicWorkbenchEditorEvidence fullProof(){return new AtomicWorkbenchEditorEvidence(r.windowId,r.displayId,r.displayName,r.displayUniqueId,r.userId,r.moduleUid,r.targetUid,r.taskId,r.packageName,fullA11y,fullGeneration,"2".repeat(32),1,0,SystemClock.time);}
  public Bundle windowState(int id){return new Bundle(states.get(id));}public int activeInputWindow(){return active;}public long inputRevision(){return revision;}public boolean sessionCurrent(long s,long g){return session&&s==7&&g==2;}
  public Bundle focusInputOnly(int id){focuses.add(id);revision++;boolean failed=id==-1&&refreshFail||id==0&&focuses.size()>1&&returnFail;if(!failed){active=id;if(id==0&&focuses.size()>1)staleWindowBinding=false;}Bundle b=new Bundle();b.putBoolean("success",!failed);return b;}
  public AtomicWorkbenchEditorEvidence queryEvidence(AtomicWorkbenchPasteRequest metadata){queries++;check(metadata.text.equals("x"),"body entered Root metadata");if(queryHook!=null)queryHook.run();if(fullMissing||staleWindowBinding||root.focus==null||!root.focus.editable||!root.focus.focused)throw new IllegalStateException("editor_evidence_rejected");return fullProof();}
  public AtomicWorkbenchEditorEvidence.WindowEvidence queryWindowEvidence(AtomicWorkbenchPasteRequest metadata){windowQueries++;if(windowQueryHook!=null)windowQueryHook.run();if(windowMissing)throw new IllegalStateException("window_evidence_unavailable");return windowProof();}
  Bundle partial(){Bundle b=host.prepare(r.metadata());check(!b.getBoolean("success")&&"editable_focus_required".equals(b.getString("reason")),"window discovery not prepared");return b;}
  public AtomicWorkbenchEditorEvidence prepare(AtomicWorkbenchPasteRequest value)throws Exception{Bundle b=host.prepare(value.metadata());if("editable_focus_required".equals(b.getString("reason"))){check(commits==0&&reads==0,"discovery accessed editor body");var proof=AtomicWorkbenchEditorEvidence.WindowEvidence.fromBundle(b.getBundle("window_evidence"));if(!AtomicWorkbenchPasteService.focusFirstVisible(value,proof))throw new IllegalStateException("editor_missing");b=host.prepare(value.metadata());}if(!b.getBoolean("success"))throw new IllegalStateException(b.getString("reason"));return AtomicWorkbenchEditorEvidence.fromBundle(b.getBundle("evidence"));}
