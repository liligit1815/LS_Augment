<?xml version="1.0" encoding="utf-8"?>
<inset android:insetLeft="0.0dp" android:insetRight="0.0dp" android:insetTop="0.0dp" android:insetBottom="0.0dp"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <layer-list>
        <item android:drawable="@drawable/card_item_bg_normal_single" />
        <item>
            <selector android:enterFadeDuration="8" android:exitFadeDuration="400">
                <item android:state_pressed="true" android:drawable="@drawable/card_item_bg_pressed_foreground_edge" />
                <item android:state_selected="true" android:drawable="@drawable/card_item_bg_pressed_foreground_edge" />
                <item android:state_checked="true" android:drawable="@drawable/card_item_bg_pressed_foreground_edge" />
            </selector>
        </item>
    </layer-list>
</inset>
