<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="false" android:state_expanded="true">
        <ripple android:color="@color/accent_ripple_color">
            <item android:drawable="@drawable/bg_widgets_header_two_pane_expanded_unfocused" />
        </ripple>
    </item>
    <item android:state_focused="false" android:state_expanded="false">
        <ripple android:color="@color/accent_ripple_color">
            <item android:drawable="@drawable/bg_widgets_header_two_pane_unexpanded_unfocused" />
        </ripple>
    </item>
    <item android:state_focused="true" android:state_expanded="true" android:drawable="@drawable/bg_widgets_header_two_pane_expanded_focused" />
    <item android:state_focused="true" android:state_expanded="false" android:drawable="@drawable/bg_widgets_header_two_pane_unexpanded_focused" />
</selector>
