<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:tint="@color/mfv_popupwindow_list_item_bg_press_color" android:shape="rectangle">
            <corners android:topLeftRadius="@dimen/mfvc_topLeftRadius" android:topRightRadius="@dimen/mfvc_topRightRadius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:tint="@color/mfv_popupwindow_list_item_bg_press_color" android:shape="rectangle">
            <corners android:topLeftRadius="@dimen/mfvc_topLeftRadius" android:topRightRadius="@dimen/mfvc_topRightRadius" />
        </shape>
    </item>
</selector>
