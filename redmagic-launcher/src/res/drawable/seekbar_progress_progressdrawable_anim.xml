<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:id="@android:id/background" android:drawable="@drawable/seekbar_background_anim">> </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/secondaryProgress">
        <selector>
            <item android:state_pressed="true" android:id="@id/pressedS" android:drawable="@drawable/seekbar_progress_pressed_shape" />
            <item android:id="@id/unpressedS" android:drawable="@drawable/seekbar_progress_unpressed_shape" />
        </selector>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/progress">
        <selector>
            <item android:state_pressed="true" android:id="@id/pressed" android:drawable="@drawable/seekbar_progress_pressed_shape" />
            <item android:id="@id/unpressed" android:drawable="@drawable/seekbar_progress_unpressed_shape" />
        </selector>
    </item>
</layer-list>
