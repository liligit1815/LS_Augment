<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="false" android:drawable="@drawable/all_apps_tabs_background_unselected_focused" />
    <item android:state_focused="true" android:state_selected="true" android:drawable="@drawable/all_apps_tabs_background_selected_focused" />
    <item android:state_focused="false" android:state_selected="false" android:id="@id/unselected">
        <ripple android:color="@color/accent_ripple_color">
            <item>
                <selector android:enterFadeDuration="100">
                    <item android:drawable="@drawable/all_apps_tabs_background_unselected" />
                </selector>
            </item>
        </ripple>
    </item>
    <item android:state_focused="false" android:state_selected="true" android:id="@id/selected">
        <ripple android:color="@color/accent_ripple_color">
            <item>
                <selector android:enterFadeDuration="100">
                    <item android:drawable="@drawable/all_apps_tabs_background_selected" />
                </selector>
            </item>
        </ripple>
    </item>
</selector>
