<?xml version="1.0" encoding="utf-8"?>
<cellSpecs
  xmlns:launcher="http://schemas.android.com/apk/res-auto">
    <specs launcher:maxAspectRatio="@dimen/aspect_ratio_portrait">
        <cellSpec launcher:dimensionType="height" launcher:maxAvailableSize="9999.0dp">
            <iconDrawablePadding launcher:fixedSize="0.0dp" />
            <iconSize launcher:fixedSize="@dimen/iconSize52dp" />
            <iconTextSize launcher:fixedSize="12.0sp" />
        </cellSpec>
    </specs>
    <specs launcher:maxAspectRatio="@dimen/aspect_ratio_landscape">
        <cellSpec launcher:dimensionType="height" launcher:maxAvailableSize="9999.0dp">
            <iconDrawablePadding launcher:fixedSize="4.0dp" />
            <iconSize launcher:fixedSize="@dimen/iconSize52dp" />
            <iconTextSize launcher:fixedSize="12.0sp" />
        </cellSpec>
    </specs>
</cellSpecs>
